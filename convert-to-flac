#!/usr/bin/env bash
set -euo pipefail

# For every file in the directory, execute ffmpeg converting
# the .wav file to a flac with the same name, organized by artist/album.

OUTPUT_DIR="/flac_output"
DEBUG=0

if [ "${1:-}" == "debug" ]; then
    echo "Debug Mode On"
    DEBUG=1
fi

# Sanitize a single path component: strip slashes, null bytes, leading dots,
# and any characters outside alphanumerics, spaces, dots, underscores, hyphens.
# Returns "unknown" if the result is empty.
sanitize_component() {
    local raw="$1"
    local sanitized
    sanitized=$(printf '%s' "$raw" \
        | tr -d '/\0' \
        | sed 's/^\.\+//' \
        | tr -cd '[:alnum:] ._-' \
        | sed 's/^[[:space:]]*//;s/[[:space:]]*$//')
    printf '%s' "${sanitized:-unknown}"
}

# Ensure no .wav glob expansion occurs when there are no matching files
shopt -s nullglob
wav_files=(*.wav)
if [ "${#wav_files[@]}" -eq 0 ]; then
    echo "No .wav files found in /wave_input"
    exit 0
fi

TEMP_JSON=$(mktemp)
trap 'rm -f "$TEMP_JSON"' EXIT

for file in "${wav_files[@]}"; do

    # Extract album, artist, title tags via ffprobe
    ffprobe -show_format -print_format json "$file" 2>/dev/null \
        | jq -r '.format.tags | {album,artist,title}' > "$TEMP_JSON"

    if [ ! -s "$TEMP_JSON" ]; then
        echo "Error: $file produced no metadata output" >&2
        exit 1
    fi

    RAW_ARTIST=$(jq -r '.artist // empty' "$TEMP_JSON")
    RAW_ALBUM=$(jq -r '.album  // empty' "$TEMP_JSON")
    RAW_TITLE=$(jq -r '.title  // empty' "$TEMP_JSON")

    # Validate required tags are present and non-empty
    if [ -z "$RAW_ARTIST" ] || [ -z "$RAW_ALBUM" ] || [ -z "$RAW_TITLE" ]; then
        if [ "$DEBUG" -eq 1 ]; then
            echo "File: $file is missing required tags (artist, album, or title)"
            echo "------------"
            cat "$TEMP_JSON"
            echo "------------"
        fi
        exit 1
    fi

    ARTIST=$(sanitize_component "$RAW_ARTIST")
    ALBUM=$(sanitize_component "$RAW_ALBUM")
    TITLE=$(sanitize_component "$RAW_TITLE")
    FILENAME="${TITLE}.flac"

    DEST_DIR="$OUTPUT_DIR/$ARTIST/$ALBUM"
    mkdir -p "$DEST_DIR"

    # Verify the resolved destination is still under OUTPUT_DIR to prevent
    # path traversal via symlinks or unexpected sanitization edge cases.
    REAL_DEST=$(realpath "$DEST_DIR")
    REAL_OUTPUT=$(realpath "$OUTPUT_DIR")
    if [[ "$REAL_DEST" != "$REAL_OUTPUT"* ]]; then
        echo "Error: resolved destination $REAL_DEST is outside $OUTPUT_DIR" >&2
        exit 1
    fi

    ffmpeg -i "$file" -acodec flac "$DEST_DIR/$FILENAME"
    if [ "$DEBUG" -eq 1 ]; then
        echo "Converted $file to $DEST_DIR/$FILENAME"
    fi
done

if [ "$DEBUG" -eq 1 ]; then
    echo "Converted all files"
fi

# Cleanup: in debug mode, prompt before deleting source files
if [ "$DEBUG" -eq 1 ]; then
    read -t 10 -p "Delete source directory? (Y/n) " DELETE_SOURCE || true
fi

if [ -z "${DELETE_SOURCE:-}" ] || [ "${DELETE_SOURCE:-}" = "y" ]; then
    rm -- "${wav_files[@]}"
    if [ "$DEBUG" -eq 1 ]; then
        echo "Deleted files from source directory"
        echo "Thank You!"
    fi
else
    if [ "$DEBUG" -eq 1 ]; then
        echo "Exiting"
        echo "Thank You!"
    fi
    exit 0
fi
